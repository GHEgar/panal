{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "types": ["node"],
        "paths": {
            "@npmegar/panal/react": [
                "./src/react/index.ts"
            ],
            "@npmegar/panal/worker/runtime": [
                "./src/worker/runtime-index.ts"
            ],
            "@npmegar/panal/worker": [
                "./src/worker/index.ts"
            ],
            "@npmegar/panal/classify": [
                "./src/classify/index.ts"
            ],
            "@npmegar/panal/deckgl": [
                "./src/deckgl/index.ts"
            ],
            "@npmegar/panal/ol": [
                "./src/ol/index.ts"
            ],
            "@npmegar/panal": [
                "./src/core/index.ts"
            ]
        }
    },
    "include": [
        "src",
        "test",
        "demo",
        "e2e",
        "playwright.config.ts"
    ]
}
