{
    "name": "@ghegar/panal",
    "version": "0.6.1",
    "description": "Headless H3 hexbin for OpenLayers: local, worker or server aggregation, zoom-driven resolution and classification.",
    "keywords": [
        "openlayers",
        "h3",
        "hexbin",
        "hexagon",
        "aggregation",
        "choropleth",
        "web-worker",
        "headless",
        "gis"
    ],
    "license": "AGPL-3.0-only",
    "author": "Edgar Villarreal",
    "type": "module",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/GHEgar/panal.git"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.js"
        },
        "./classify": {
            "types": "./dist/classify/index.d.ts",
            "import": "./dist/classify/index.js"
        },
        "./ol": {
            "types": "./dist/ol/index.d.ts",
            "import": "./dist/ol/index.js"
        },
        "./worker": {
            "types": "./dist/worker/index.d.ts",
            "import": "./dist/worker/index.js"
        },
        "./worker/runtime": {
            "types": "./dist/worker/runtime-index.d.ts",
            "import": "./dist/worker/runtime-index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "demo": "vite --config demo/vite.config.ts",
        "demo:build": "vite build --config demo/vite.config.ts",
        "e2e": "playwright test"
    },
    "dependencies": {
        "h3-js": "^4.5.0"
    },
    "peerDependencies": {
        "ol": ">=10",
        "react": ">=19"
    },
    "peerDependenciesMeta": {
        "ol": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@npmegar/eslint-config": "^0.4.0",
        "@playwright/test": "^1.64.0",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.12.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "happy-dom": "^20.14.5",
        "ol": "^10.11.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    },
    "overrides": {
        "eslint-plugin-jsx-a11y": {
            "eslint": "$eslint"
        }
    }
}
